// Landing page: static files only, served by Cloudflare at screentimehistory.rsemihkoca.com.
//   npx wrangler deploy        (from this folder)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "screentimehistory-site",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "html_handling": "auto-trailing-slash", "not_found_handling": "none" },
  "routes": [{ "pattern": "screentimehistory.rsemihkoca.com", "custom_domain": true }]
}
